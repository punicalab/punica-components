{
  "name": "@punica/components",
  "version": "2.5.2",
  "description": "Punica web components: framework-free custom elements on platform standards.",
  "keywords": [
    "web-components",
    "custom-elements",
    "design-system",
    "ui",
    "components",
    "form-associated",
    "accessibility",
    "shadow-dom"
  ],
  "homepage": "https://components.punicalab.com",
  "bugs": {
    "url": "https://github.com/punicalab/punica-components/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/punicalab/punica-components.git"
  },
  "license": "MIT",
  "author": "PunicaLab",
  "type": "module",
  "main": "./dist/esm/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "unpkg": "./dist/punica-components.min.js",
  "customElements": "custom-elements.json",
  "web-types": "./dist/web-types.json",
  "sideEffects": [
    "./dist/**/*.js",
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/esm/index.js"
    },
    "./components/*": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/esm/components/*"
    },
    "./core/*": "./dist/esm/core/*",
    "./tokens.css": "./dist/tokens.css",
    "./tokens/*.tokens.json": "./dist/tokens/*.tokens.json",
    "./ssr": {
      "types": "./dist/ssr/index.d.ts",
      "default": "./dist/ssr/index.js"
    },
    "./react": {
      "types": "./dist/types/react.d.ts"
    },
    "./custom-elements.json": "./custom-elements.json",
    "./global": "./dist/punica-components.min.js",
    "./ai": {
      "types": "./dist/ai/index.d.ts",
      "default": "./dist/ai/index.mjs"
    },
    "./ai/node": {
      "types": "./dist/ai/node.d.ts",
      "default": "./dist/ai/node.mjs"
    },
    "./llms.txt": "./dist/llms.txt",
    "./llms-full.txt": "./dist/llms-full.txt",
    "./vscode.html-custom-data.json": "./dist/vscode.html-custom-data.json",
    "./vscode.css-custom-data.json": "./dist/vscode.css-custom-data.json",
    "./web-types.json": "./dist/web-types.json"
  },
  "files": [
    "dist",
    "custom-elements.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/MIGRATION-2.0.md",
    "docs/contract.md",
    "docs/migration",
    "scripts/codemod-2.0.mjs",
    "scripts/codemod-rules.mjs",
    "bin",
    "skills"
  ],
  "scripts": {
    "build": "node scripts/build.mjs && npm run manifest",
    "barrel": "node scripts/barrel.mjs",
    "manifest": "cem analyze --config custom-elements-manifest.config.mjs && node scripts/types.mjs && node scripts/llms.mjs",
    "audit": "node scripts/audit.mjs",
    "lint": "eslint src scripts test bin packages/mcp/src packages/mcp/test packages/mcp/build.mjs eval",
    "format": "prettier --write \"./**/*.{ts,js,mjs,json,md}\"",
    "test": "vitest run && npm run test:types && npm run test:ssr",
    "test:types": "node --test test/types.test.mjs",
    "test:ssr": "node --test test/ssr.test.mjs",
    "test:watch": "vitest",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "npm run build && changeset publish",
    "prepublishOnly": "npm run lint && npm test && npm run build",
    "pack:check": "npm pack --dry-run",
    "pretest": "npm run build",
    "build:mcp": "npm --prefix packages/mcp run build",
    "test:mcp": "npm --prefix packages/mcp test",
    "eval": "node eval/run.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@types/react": ">=18",
    "happy-dom": ">=20"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    },
    "happy-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "@changesets/cli": "^3.0.3",
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.0.0",
    "@vitest/browser": "^5.1.1",
    "@vitest/browser-playwright": "^5.1.1",
    "axe-core": "^4.14.1",
    "custom-element-jet-brains-integration": "^1.8.0",
    "custom-element-vs-code-integration": "^1.5.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "playwright": "^1.65.1",
    "prettier": "^2.8.3",
    "typescript": "^5.9.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "bin": {
    "punica-components": "bin/punica-components.mjs"
  }
}
